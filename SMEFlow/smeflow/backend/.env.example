NODE_ENV=development
PORT=5000

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/smeflow
DB_RETRY_MS=5000
# For MongoDB Atlas, replace the line above with:
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER-URL/smeflow?retryWrites=true&w=majority

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Cron (automation)
CRON_SCHEDULE=0 0 * * *
